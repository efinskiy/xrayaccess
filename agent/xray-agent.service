[Unit]
Description=Xray Dashboard Log Agent
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/xray-agent -config /etc/xray-agent/config.yaml
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xray-agent

[Install]
WantedBy=multi-user.target
